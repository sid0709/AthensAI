# Root env template (local reference). Prefer athens-backend/.env and Athens/.env.
PORT=8980
ATHENS_BACKEND_PORT=8980
VITE_API_BASE=http://127.0.0.1:8980/api

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_AUTH_REQUIRED=false

# See athens-backend/.env.example for DATABASE_URL and API_KEYS_ENCRYPTION_KEY.

{
  "name": "nextoffer",
  "private": true,
  "workspaces": [
    "packages/shared"
  ],
  "dependencies": {
    "@nextoffer/shared": "file:packages/shared",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.19.2"
  },
  "scripts": {
    "prestart": "node scripts/prestart.mjs",
    "start": "node scripts/dev-start.mjs",
    "install:all": "npm install && npm install --prefix Athens && npm install --prefix athens-backend",
    "start:athens-backend": "npm run start:dev --prefix athens-backend",
    "start:ui": "npm run dev --prefix Athens",
    "build:backend": "npm run prisma:generate --prefix athens-backend && npm run build --prefix athens-backend"
  }
}

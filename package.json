{
  "name": "nextoffer",
  "private": true,
  "workspaces": [
    "packages/shared",
    "Athens-server",
    "ai-bff",
    "project-avalon/packages/shared",
    "project-avalon/packages/backend"
  ],
  "dependencies": {
    "@nextoffer/shared": "file:packages/shared",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "scripts": {
    "prestart": "node scripts/prestart.mjs",
    "start": "node scripts/dev-start.mjs",
    "install:all": "npm install && npm install --prefix Athens && npm run build -w ai-bff",
    "backfill-job-skills": "npm run backfill-job-skills -w Athens-server",
    "migrate:firestore-first": "npm run migrate:firestore-first -w Athens-server",
    "reconcile:firestore-first": "npm run reconcile:firestore-first -w Athens-server",
    "build:ai": "npm run build -w ai-bff",
    "verify:firestore-only": "node scripts/verify-firestore-only.mjs",
    "start:athens-server": "npm run start -w Athens-server",
    "start:ai": "npm run start -w ai-bff",
    "start:avalon-relay": "npm run start -w @avalon/backend",
    "start:ui": "npm run dev --prefix Athens"
  }
}

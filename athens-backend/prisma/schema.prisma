generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Shared with Athens-server / Firestore sync shape. Collection: account_info.
model AccountInfo {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  name              String  @unique
  /// Lowercased login key. Not unique in Prisma — legacy rows may share null.
  usernameKey       String?
  password          String?
  tier              String?
  permission        String?
  vendorAllowed     Boolean?
  vendorPassword    String?
  autoBidProfile    Json?
  notificationPrefs Json?
  notionIntegration Json?
  /// Analyzed library skills by stack title: { [title]: [{ name, category, level }] }
  resumeAnalysisCatalog Json?
  /// ISO-8601 string (Athens-server contract — not BSON Date).
  resumeAnalysisCatalogUpdatedAt String?
  /// AI Mail labeling: { [labelPath: string]: description }
  mailAiLabelDefinitions Json?

  jobStatusCounts JobStatusCounts?
  jobStatuses     JobStatus[]
  resumes         Resume[]

  @@index([usernameKey])
  @@map("account_info")
}

/// Employer identity for Job Search grouping. jobIds are catalog `jobs` ids, newest-first.
model Company {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Normalized companyName (trim + lowercase + collapse whitespace).
  companyKey   String   @unique
  companyName  String
  companyLogo  String?
  companyUrl   String?
  jobIds       String[] @db.ObjectId
  lastPostedAt DateTime
  /// Denormalized jobIds.length for cheap unfiltered counts.
  jobCount     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastPostedAt(sort: Desc)])
  @@map("companies")
}

/// Lean Job Search catalog (searchable). Incomplete title-review / skill-extract rows live in `temp_jobs`.
/// Filter/search fields are flat; capsules live in metadata.
model Job {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  companyName      String
  /// FK to companies._id (no Prisma relation — membership lives on Company.jobIds).
  companyId        String?  @db.ObjectId
  source           String
  postedAt         DateTime
  titleReviewLabel String
  sourceCatalog    String   @default("market")
  companyLink      String?
  applyLink        String?
  description      String?
  /// [{ name, category, requirement }]
  aiSkills         Json?
  aiSkillStatus    String?
  modelSchemaCode  String   @map("model_schema_code")
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// { legacyId?, companyLogo?, details?: { location?, time?, remote?, seniority?, salary? }, titleReview? }
  metadata         Json?

  statuses JobStatus[]

  /// Unfiltered Job Search: orderBy postedAt desc without a leading filter key.
  @@index([postedAt(sort: Desc)])
  @@index([titleReviewLabel, postedAt(sort: Desc)])
  @@index([titleReviewLabel, source, postedAt(sort: Desc)])
  @@index([sourceCatalog, titleReviewLabel, postedAt(sort: Desc)])
  @@index([createdBy, postedAt(sort: Desc)])
  @@index([companyId, postedAt(sort: Desc)])
  @@map("jobs")
}

/// Staging ingest shape (≠ Job). Scrapers land here after prenorm.
/// Title Review + Skill Extract filter this collection directly (no athens_metadata).
/// Promote into `jobs` via registerJob when titleReviewLabel=APPROVED and aiSkillStatus is done.
model TempJob {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  companyName      String
  companyId        String?  @db.ObjectId
  source           String
  postedAt         DateTime
  /// Raw relative posting text from scrapers (e.g. "2 days ago").
  postedAgo        String?
  titleReviewLabel String
  sourceCatalog    String   @default("market")
  companyLink      String?
  applyLink        String?
  description      String?
  /// [{ name, category, requirement }]
  aiSkills         Json?
  aiSkillStatus    String?
  modelSchemaCode  String   @map("model_schema_code")
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// { legacyId?, companyLogo?, details?, titleReview?, scrape? }
  metadata         Json?

  @@index([postedAt(sort: Desc)])
  @@index([titleReviewLabel, postedAt(sort: Desc)])
  @@index([titleReviewLabel, source, postedAt(sort: Desc)])
  @@index([aiSkillStatus, postedAt(sort: Desc)])
  @@index([createdBy, postedAt(sort: Desc)])
  @@index([companyId, postedAt(sort: Desc)])
  @@map("temp_jobs")
}

/// One row per profile × job. Status is owned by the profile, never shared.
model JobStatus {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  jobId     String   @db.ObjectId
  /// posted | bid-ready | bid-completed | applied | scheduled | declined
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account AccountInfo @relation(fields: [profileId], references: [id])
  job     Job         @relation(fields: [jobId], references: [id])

  @@unique([profileId, jobId])
  @@index([profileId, state])
  @@index([jobId])
  @@map("job_statuses")
}

/// One document per profile. Job Search status-tab badges read this at O(1).
model JobStatusCounts {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId    String   @unique @db.ObjectId
  posted       Int      @default(0)
  bidReady     Int      @default(0)
  bidCompleted Int      @default(0)
  applied      Int      @default(0)
  scheduled    Int      @default(0)
  declined     Int      @default(0)
  updatedAt    DateTime @updatedAt

  account AccountInfo @relation(fields: [profileId], references: [id])

  @@map("job_status_counts")
}

/// Uploaded / generated resume library. Binary lives in Firebase Storage;
/// this row holds title (upload folder), file meta, and analysis object.
model Resume {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String    @db.ObjectId
  ownerName     String
  /// Upload folder / stack label (legacy API field: techStack)
  title         String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  contentSha256 String
  extractedText String?
  isPrimary     Boolean   @default(false)
  source        String    @default("uploaded")
  generationId  String?
  templateId    String?
  analyzed      Boolean   @default(false)
  analyzedAt    DateTime?
  /// { skills: [{ name, category, level }], provider?, model?, usage? }
  analysis      Json?
  analysisError String?
  uploadedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account AccountInfo @relation(fields: [profileId], references: [id])

  @@index([profileId, uploadedAt(sort: Desc)])
  @@index([profileId, title])
  @@index([ownerName, uploadedAt(sort: Desc)])
  @@map("resumes")
}

/// Cached Gmail message (list = headers/snippet; body filled on open).
model MailMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  applierName String
  mailbox     String
  uid         Int
  messageId   String?
  fromName    String?
  fromEmail   String?
  toJson      Json?
  ccJson      Json?
  subject     String
  preview     String   @default("")
  bodyText    String?
  bodyHtml    String?
  date        DateTime
  seen        Boolean  @default(false)
  flagged     Boolean  @default(false)
  gmailLabels String[]
  folder      String   @default("inbox")
  labels      String[]
  hasBody     Boolean  @default(false)
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([applierName, mailbox, uid])
  @@index([applierName, folder, date(sort: Desc)])
  @@index([applierName, date(sort: Desc)])
  @@map("mail_messages")
}

/// Per-applier mail sync cursors + cached Gmail label list.
model MailSyncState {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  applierName      String    @unique
  highestUid       Int       @default(0)
  lowestUid        Int       @default(0)
  lastSyncAt       DateTime?
  syncing          Boolean   @default(false)
  gmailLabelsJson  Json?
  folderCountsJson Json?
  updatedAt        DateTime  @updatedAt

  @@map("mail_sync_state")
}

/// Background task queue (mail_ai_label and future types).
model BackgroundTask {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  requestId            String?
  type                 String
  status               String
  profileId            String?
  applierName          String?
  payload              Json?
  progress             Json?
  result               Json?
  error                String?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  cancelRequestedAt    DateTime?
  cancelAcknowledgedAt DateTime?
  finishedAt           DateTime?
  updatedAt            DateTime  @updatedAt
  eventSequence        Int       @default(0)

  @@index([requestId])
  @@index([profileId, status, updatedAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@index([type, status])
  @@map("background_tasks")
}

/// Idempotency reservations for background tasks.
model BackgroundTaskReservation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  key       String    @unique
  taskId    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("background_task_reservations")
}

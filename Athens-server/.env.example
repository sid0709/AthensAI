PORT=8979
HOST=0.0.0.0

# Firebase Admin SDK (server only).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_AUTH_REQUIRED=false
FIRESTORE_WRITES_ENABLED=false
KMS_KEY_NAME=projects/your-project-id/locations/us-east4/keyRings/athens/cryptoKeys/profile-secrets
API_KEYS_ENCRYPTION_KEY=

# Algolia is used only for full-text and complex-filter search.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_JOBS_INDEX=athens_jobs
ALGOLIA_JOBS_LATEST_INDEX=athens_jobs_latest
SEARCH_OUTBOX_INTERVAL_MS=5000
SEARCH_OUTBOX_BATCH_SIZE=100
ALGOLIA_OUTBOX_MAX_LAG_SECONDS=300

# Firestore background tasks and worker leases.
BACKGROUND_WORKERS_MODE=local
BACKGROUND_AI_TASK_CONCURRENCY=16
BACKGROUND_IO_TASK_CONCURRENCY=4
BACKGROUND_PDF_TASK_CONCURRENCY=2
BACKGROUND_CLEANUP_TASK_CONCURRENCY=2
BACKGROUND_WORKER_HEARTBEAT_MAX_AGE_MS=20000
BACKGROUND_TASK_LEASE_MS=120000
BACKGROUND_TASK_RETENTION_SECONDS=604800
BACKGROUND_WORKER_METRICS_PORT=9102

# Athens Lens Firestore sessions.
ATHENS_LENS_SESSION_TTL_SECONDS=43200

# AI gateway and feature workers.
AI_BFF_URL=http://127.0.0.1:3920
LLM_TIMEOUT_MS=600000
JOB_SKILL_EXTRACT_CONCURRENCY=16
JOB_SKILL_EXTRACT_MAX_CHARS=8000
JOB_SKILL_EXTRACT_MAX_ATTEMPTS=3
JOB_TITLE_REVIEW_CONCURRENCY=10
JOB_TITLE_REVIEW_BATCH_SIZE=10
JOB_TITLE_REVIEW_STALE_LEASE_MS=900000

# Mail uses Firestore as authority and bounded process-local caches.
MAIL_ACCOUNT_CACHE_MS=30000
MAIL_ACCOUNT_CACHE_MAX=200
MAIL_MEMORY_CACHE_MAX=500
MAIL_SYNC_MIN_INTERVAL_MS=45000

# Monitoring.
MONITORING_ENABLED=false
PROMETHEUS_URL=http://prometheus:9090
METRICS_PORT=9101
MONITOR_STALE_AFTER_MS=120000

{
	"name": "AIMS-backend",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"start": "nodemon index.js",
		"worker:background": "BACKGROUND_TASK_WORKER=true node src/workers/backgroundTaskWorker.js",
		"postinstall": "node ./scripts/ensure-puppeteer-chrome.mjs || echo \"[puppeteer] Chrome install deferred — run: npm run install:chrome -w Athens-server\"",
		"install:chrome": "node ./scripts/ensure-puppeteer-chrome.mjs",
		"test:matching": "node --test ../packages/shared/src/pricing.test.mjs ../packages/shared/src/matching.test.mjs",
		"test:profile-skills": "node --test src/scripts/cleanupLegacyPersonalSkills.test.mjs",
		"test:external-jobs": "node --test src/services/externalScrapedJobsListQuery.test.mjs",
		"test:ai-usage": "node --test src/services/aiUsageQuery.test.mjs",
		"test:resume-templates": "node --test src/services/resumeTemplate.test.mjs",
		"test:resume-gen": "node --test src/controllers/resumeGenController.test.mjs src/services/resumeCareerTitlePolicy.test.mjs src/services/resumeCoverageService.test.mjs src/services/resumeGenerationService.test.mjs src/services/resumeGeneratorConfigSchema.test.mjs src/lib/betaTier.test.mjs src/services/agentResumeReuse.test.mjs src/services/refreshGeneratedResumesIdentity.test.mjs",
		"test:concurrency": "node --test src/utils/concurrency.test.mjs",
		"test:background-tasks": "node --test src/db/redis.test.mjs src/services/backgroundTasks/*.test.mjs",
		"load-test:background-tasks": "node src/scripts/loadBackgroundTasks.mjs",
		"firebase:normalize-job-statuses": "node src/scripts/normalizeJobStatuses.js",
		"firebase:repair-job-status-caches": "node src/scripts/repairJobStatusCaches.js",
		"firebase:cleanup-legacy-skills": "node src/scripts/cleanupLegacyPersonalSkills.js",
		"backfill-job-skills": "node src/scripts/backfillJobSkills.js",
		"backfill-match-scores": "node src/scripts/backfillMatchScores.js",
		"backfill-query-ranking": "node src/scripts/backfillQueryRanking.js",
		"migrate-company-identity": "node src/scripts/migrateCompanyIdentity.js",
		"merge-companies": "node src/scripts/mergeCompanyIds.js",
		"rebuild-public-date-tail": "node src/scripts/rebuildPublicDateTail.js",
		"validate-query-ranking": "node src/scripts/validateQueryRanking.js",
		"benchmark-query-ranking": "node src/scripts/benchmarkQueryRanking.js",
		"test:query-ranking": "node --test src/services/matching/canonicalSkillVectors.test.mjs src/services/matching/exactRerank.test.mjs src/services/matching/jobRankingIndex.test.mjs src/services/matching/rankingEvaluation.test.mjs",
		"test:company-grouping": "node --test src/services/companyIdentity.test.mjs src/services/companyGroupedJobsService.test.mjs",
		"test:job-list-v2": "node --test src/controllers/agentController.test.mjs src/services/jobListReadModelService.test.mjs src/services/jobRankingCatalogReconciler.test.mjs src/services/jobStatusProjectionService.test.mjs src/services/jobTitleReview/titleReviewIndexSync.test.mjs",
		"qdrant:start": "docker compose -f ../compose.yaml up -d --wait qdrant",
		"qdrant:stop": "docker compose -f ../compose.yaml stop qdrant",
		"redis:start": "docker compose -f ../compose.yaml up -d --wait redis",
		"redis:stop": "docker compose -f ../compose.yaml stop redis",
		"reset-skills": "node src/scripts/resetSkills.js",
		"remove-embeddings": "node src/scripts/removeEmbeddings.js",
		"cleanup-job-market-fields": "node src/scripts/cleanupJobMarketFields.js",
		"migrate-job-title-review": "node src/scripts/migrateJobTitleReview.js",
		"migrate-job-title-review:dry-run": "node src/scripts/migrateJobTitleReview.js --dry-run",
		"backfill-title-review-pending": "node src/scripts/migrateJobTitleReview.js --pending-only",
		"backfill-title-review-pending:dry-run": "node src/scripts/migrateJobTitleReview.js --pending-only --dry-run",
		"deploy-title-review-indexes": "node src/scripts/deployTitleReviewIndexes.js --wait",
		"rebuild-title-review-read-model": "node src/scripts/rebuildTitleReviewReadModel.js",
		"benchmark-title-review": "node src/scripts/benchmarkTitleReviewReadModel.js",
		"test:title-review": "node --test src/services/jobTitleReview/*.test.mjs src/scripts/migrateJobTitleReview.test.mjs",
		"monitoring:rollup": "node src/scripts/rollupMonitoring.js",
		"test:monitoring": "node --test src/services/monitoring/*.test.mjs",
		"test:firestore-adapter": "node --test src/db/firestoreDataAdapter.test.mjs",
		"test:firestore-status": "node --test src/services/jobStatusCache.test.mjs src/services/jobStatusCacheMaintenance.test.mjs src/services/jobStatusProjectionService.test.mjs"
	},
	"dependencies": {
		"@google-cloud/kms": "^5.4.0",
		"@nextoffer/shared": "file:../packages/shared",
		"algoliasearch": "^5.56.0",
		"archiver": "^8.0.0",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.81.3",
		"cheerio": "^1.2.0",
		"cors": "^2.8.5",
		"docx": "^9.7.1",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"firebase-admin": "^14.2.0",
		"google-auth-library": "^10.9.1",
		"googleapis": "^155.0.0",
		"html-to-docx": "^1.8.0",
		"imapflow": "^1.4.2",
		"mailparser": "^3.9.14",
		"mammoth": "^1.12.0",
		"node-gyp-build": "^4.8.4",
		"nodemailer": "^9.0.1",
		"pdf-parse": "^1.1.4",
		"peberminta": "^0.10.0",
		"pizzip": "^3.2.0",
		"puppeteer": "^25.1.0",
		"redis": "^4.7.0",
		"socket.io": "^4.8.1",
		"tlds": "^1.261.0",
		"uc.micro": "^2.1.0"
	},
	"devDependencies": {
		"nodemon": "^3.1.14",
		"readdirp": "^3.6.0",
		"to-regex-range": "^5.0.1"
	}
}

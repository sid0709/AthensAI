# athens-backend API base (must include /api).
# Local default:
WXT_ATHENS_API_URL=http://127.0.0.1:8980/api
#
# Production (cloud) example — prefer baking via docker/pack-extensions.sh
# which XOR-encodes the URL as enc:<token> so the zip has no plaintext host:
# WXT_ATHENS_API_URL=https://athensai.remotepairnet.net/api

# Copy to /opt/nextoffer/deploy.env and chmod 600. Do not commit real secrets.
API_KEYS_ENCRYPTION_KEY=CHANGE_ME
DATABASE_URL=mongodb://USER:PASSWORD@HOST:27017/AthensDB?authSource=admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_SECRET_HOST_PATH=/opt/nextoffer/secrets/firebase-service-account.json
KMS_KEY_NAME=projects/your-project-id/locations/us-east4/keyRings/athens/cryptoKeys/profile-secrets
FIREBASE_AUTH_REQUIRED=false
BACKGROUND_WORKERS_MODE=embedded
PORT=8980
METRICS_PORT=9101
CORS_ORIGIN=*
PROMETHEUS_URL=http://prometheus:9090
MONITORING_ENABLED=true

{
  "title": "Athens Operations",
  "uid": "athens-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "VPS utilization",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "athens:node_cpu_utilization:ratio * 100", "legendFormat": "CPU" },
        { "expr": "athens:node_memory_utilization:ratio * 100", "legendFormat": "Memory" },
        { "expr": "athens:root_filesystem_utilization:ratio * 100", "legendFormat": "Disk" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Firestore task queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "athens_background_queue_oldest_age_seconds", "legendFormat": "Oldest queue age" },
        { "expr": "athens_background_expired_lease_count", "legendFormat": "Expired leases" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Algolia outbox lag",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "athens_algolia_outbox_lag_seconds", "legendFormat": "Lag" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Service availability",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "athens_health_status", "legendFormat": "{{component}}" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    }
  ],
  "tags": ["athensai", "firebase", "algolia"]
}

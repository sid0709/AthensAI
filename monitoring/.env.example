# Copy to /opt/athens-monitoring/.env on the VPS. Keep permissions 600.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://127.0.0.1:3000
# Optional: use the host's public URL for the blackbox targets if it is HTTPS.
ATHENS_PUBLIC_ORIGIN=http://127.0.0.1:9030
GCP_PROJECT_ID=drwretail-bm
GCP_MONITORING_CREDENTIALS_PATH=/opt/athens-monitoring/secrets/monitoring-reader.json
# These two values are installed from the same read-only service-account JSON
# by the deployment workflow. Preserve the PEM newlines in the private key.
GCP_MONITORING_CLIENT_EMAIL=athens-monitoring-reader@drwretail-bm.iam.gserviceaccount.com
GCP_MONITORING_PRIVATE_KEY=CHANGE_ME
